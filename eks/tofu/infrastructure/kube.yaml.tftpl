apiVersion: v1
clusters:
- cluster:
    server: ${ cluster_endpoint }
    certificate-authority-data: ${ cluster_ca_data }
  name: kubernetes
contexts:
- context:
    cluster: kubernetes
    user: aws
  name: aws
current-context: aws
kind: Config
preferences: {}
users:
- name: aws
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      command: aws
      env:
      - name: "AWS_PROFILE"
        value: ${ aws_profile }
      args:
      - --region
      - ${ region }
      - eks
      - get-token
      - --cluster-name
      - ${ cluster_name }

